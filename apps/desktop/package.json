{
  "name": "@agentdeck/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Electron 桌面壳：拉起本机后端并加载其页面",
  "author": "AgentDeck contributors",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "package": "node ../../node_modules/electron/install.js && electron-builder --config electron-builder.yml --win nsis portable --x64 --publish never",
    "package:dir": "node ../../node_modules/electron/install.js && electron-builder --config electron-builder.yml --win --x64 --dir --publish never"
  },
  "devDependencies": {
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "vite": "8.3.1"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.286",
    "@anthropic-ai/sdk": "0.131.0",
    "@fastify/static": "10.1.9",
    "@fastify/websocket": "11.3.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "csv-parse": "7.0.3",
    "fastify": "5.12.8",
    "smol-toml": "1.9.0",
    "ssh-config": "5.3.0",
    "ssh2": "1.17.0",
    "zod": "4.6.7"
  }
}
